{
  "expo": {
    "name": "GBA-ECO",
    "slug": "GBA-ECO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gbaeco",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.koffiephraim12.GBAECO"
    },
    "android": {
      "adaptiveIcon": {
       "foregroundImage": "./assets/images/icon-gba-eco.png",
        "backgroundColor": "#065f46"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.koffiephraim12.GBAECO"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/logo.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39f3c229-2d4f-47bc-a31d-c3124c8f6cb9"
      }
    }
  }
}
